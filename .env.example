# LLM provider, pick one and fill in its key
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# "<provider>:<model>", e.g. openai:gpt-5.5, anthropic:claude-opus-5-5 or google_genai:gemini-3.5-flash
LLM_MODEL=openai:gpt-5.5

# Optional, connect a real Shopify store instead of the mock data in data/.
# Without these, everything reads from data/orders.json and data/inventory.json.
SHOPIFY_STORE_URL=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=
# Admin API version, change it when Shopify retires this one
SHOPIFY_API_VERSION=2026-04

# Optional, used by stock_monitor.py to post low-stock alerts to Slack
SLACK_WEBHOOK_URL=
